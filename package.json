{
	"name": "pixeldeck-ajazz",
	"version": "0.1.0",
	"description": "Open-source desktop control software for Ajazz stream controllers",
	"author": "mistweaverco and friends",
	"license": "GPL-3.0-or-later",
	"repository": "https://github.com/dvgamerr/pixeldeck-ajazz",
	"scripts": {
		"dev": "bun x --bun --no-install vite dev",
		"build": "bun x --bun --no-install vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "bun x --bun prettier --write \"src/**/*.{ts,svelte,css,html}\" \"plugins/**/*.{js,ts,html}\" \"*.{js,ts,json}\"",
		"format:check": "bun x --bun prettier --check \"src/**/*.{ts,svelte,css,html}\" \"plugins/**/*.{js,ts,html}\" \"*.{js,ts,json}\"",
		"lint": "bun x --bun eslint .",
		"test": "bun test",
		"verify": "bun run format:check && bun run check && bun run lint && bun test && bun run build",
		"icon:generate": "pwsh -NoProfile -File scripts/generate-icons.ps1",
		"installer:windows": "bun run tauri build --bundles nsis,msi",
		"sync:version": "bun scripts/version-tag.mjs",
		"cg:update": "cargo update --manifest-path src-tauri/Cargo.toml && cargo update --manifest-path src-tauri/lib/ajazz-sdk/Cargo.toml && cargo update --manifest-path plugins/com.amansprojects.starterpack.sdPlugin/Cargo.toml && cargo update --manifest-path plugins/com.dvgamerr.widgets.sdPlugin/Cargo.toml",
		"tauri": "bun x --bun --no-install tauri"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "2.11.4",
		"@types/node": "^26.6.1",
		"daisyui": "^5.7.42",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"lightningcss": "^1.33.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"packageManager": "bun@1.3.14",
	"type": "module",
	"dependencies": {
		"@tauri-apps/api": "2.11.1",
		"@tauri-apps/plugin-deep-link": "2.4.10",
		"@tauri-apps/plugin-dialog": "2.7.3",
		"dompurify": "^3.4.15",
		"marked": "^18.0.13",
		"marked-base-url": "^1.1.10",
		"phosphor-svelte": "^3.1.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
