{
	"Name": "PixelDeck Widgets",
	"Description": "Fast native dashboard widgets for PixelDeck",
	"Author": "dvgamerr",
	"Version": "1.0.1",
	"CodePathWin": "windows/bin/pixeldeck-widgets.exe",
	"CodePathMac": "darwin/bin/pixeldeck-widgets",
	"CodePathLin": "linux/bin/pixeldeck-widgets",
	"Icon": "icons/plugin",
	"Category": "PixelDeck",
	"OS": [{ "Platform": "windows" }, { "Platform": "mac" }, { "Platform": "linux" }],
	"Actions": [
		{
			"Icon": "icons/gold",
			"Name": "Gold Price",
			"States": [{ "Image": "actionDefaultImage", "ShowTitle": false }],
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"Tooltip": "YLG spot gold price in USD or THB",
			"UUID": "com.dvgamerr.widgets.gold-price",
			"PropertyInspectorPath": "propertyInspector/widget.html"
		},
		{
			"Icon": "icons/currency",
			"Name": "Currency Rate",
			"States": [{ "Image": "actionDefaultImage", "ShowTitle": false }],
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"Tooltip": "Yahoo Finance currency exchange rate",
