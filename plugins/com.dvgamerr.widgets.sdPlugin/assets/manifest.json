			"PropertyInspectorPath": "propertyInspector/widget.html"
		},
		{
			"Icon": "icons/stock",
			"Name": "Stock Price",
			"States": [{ "Image": "actionDefaultImage", "ShowTitle": false }],
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
